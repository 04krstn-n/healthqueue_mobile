# HealthQueue+ Mobile App — environment configuration
# Copy this to .env and fill in your values

# Backend API server URL
# Android emulator → use 10.0.2.2 (loopback to host machine)
# Physical device  → use your machine's LAN IP, e.g. http://192.168.137.1:4000
API_BASE_URL=https://api.healthqueue.org/api
